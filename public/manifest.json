{
    "name": "PocketRisu",
    "short_name": "PocketRisu",
    "id": "/",
    "scope": "/",
    "icons": [
        {
            "src": "logo_512.png",
            "type": "image/png",
            "sizes": "512x512"
        },
        {
            "src": "logo_192.png",
            "type": "image/png",
            "sizes": "192x192"
        },
        {
            "src": "logo_16.png",
            "type": "image/png",
            "sizes": "16x16"
        },
        {
            "src": "logo_32.png",
            "type": "image/png",
            "sizes": "32x32"
        },
        {
            "src": "logo_256.png",
            "type": "image/png",
            "sizes": "256x256"
        }
    ],
    "start_url": "/",
    "display": "standalone",
    "theme_color": "#4682B4",
    "background_color": "#111827",
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "application/octet-stream": [".charx", ".risup", ".risum"]
            }
        }
    ],
    "share_target": {
        "action": "/sw/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "url": "url",
            "text": "text",
            "title": "title",
            "files": {
                "name": "files",
                "accept": [
                    "application/octet-stream",
                    "application/json",
                    "application/zip",
                    "application/x-zip-compressed",
                    "image/png",
                    "image/jpeg",
                    ".charx",
                    ".risum",
                    ".risup",
                    ".risupreset",
                    ".lorebook",
                    ".json",
                    ".png",
                    ".jpg",
                    ".jpeg"
                ]
            }
        }
    }
}
