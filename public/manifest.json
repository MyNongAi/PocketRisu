{
    "name": "PocketRisu",
    "short_name": "PocketRisu",
    "icons": [
        {
            "src": "logo_512.png",
            "type": "image/png",
            "sizes": "512x512"
        },
        {
            "src": "logo_192.png",
            "type": "image/png",
            "sizes": "192x192"
        },
        {
            "src": "logo_16.png",
            "type": "image/png",
            "sizes": "16x16"
        },
        {
            "src": "logo_32.png",
            "type": "image/png",
            "sizes": "32x32"
        },
        {
            "src": "logo_256.png",
            "type": "image/png",
            "sizes": "256x256"
        }
    ],
    "start_url": "/",
    "display": "standalone",
    "theme_color": "#4682B4",
    "background_color": "#111827",
    "file_handlers": [
        {
            "action": "/",
            "accept": {
                "application/octet-stream": [".charx", ".risup", ".risum"]
            }
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "GET",
        "params": {
            "url": "url",
            "text": "text",
            "title": "title"
        }
    }
}
